<% layout("/layouts/boilerplate") %>

<section class="form-page">
  <h1 class="form-page__title">Edit listing</h1>
  <p class="form-page__subtitle">Update the details for <%= listing.title %>.</p>

  <form action="/listings/<%= listing._id %>?_method=PUT" method="POST" class="listing-form" novalidate>
    <label class="field">
      <span>Title</span>
      <input type="text" name="listing[title]" value="<%= listing.title %>" required />
    </label>

    <label class="field">
      <span>Description</span>
      <textarea name="listing[description]" rows="4" required><%= listing.description %></textarea>
    </label>

    <div class="field-row">
      <label class="field">
        <span>Image URL</span>
        <input type="text" name="listing[image][url]" value="<%= listing.image.url %>" />
      </label>

      <label class="field field--small">
        <span>Price per night (&#8377;)</span>
        <input type="number" name="listing[price]" min="0" value="<%= listing.price %>" required />
      </label>
    </div>

    <div class="field-row">
      <label class="field">
        <span>Location</span>
        <input type="text" name="listing[location]" value="<%= listing.location %>" required />
      </label>

      <label class="field">
        <span>Country</span>
        <input type="text" name="listing[country]" value="<%= listing.country %>" required />
      </label>
    </div>

    <button type="submit" class="btn btn--primary">Save changes</button>
  </form>
</section>
